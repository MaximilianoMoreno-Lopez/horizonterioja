---
// El sol de arcos del logo como ornamento (sin la palabra). Mismos trazos que Logo.astro.
interface Props {
  class?: string;
  tono?: 'vino' | 'claro';
}
const { class: clase, tono = 'vino' } = Astro.props;
---

<svg class:list={['horizon-lines', tono, clase]} viewBox="20 40 260 168" aria-hidden="true" focusable="false">
  <g fill="none" stroke-width="8" stroke-linecap="round">
    <path class="hl-base" d="M 70 130 A 80 80 0 0 1 230 130" />
    <path d="M 83 130 A 67 67 0 0 1 217 130" stroke="#B83A44" />
    <path d="M 96 130 A 54 54 0 0 1 204 130" stroke="#E07A3B" />
    <path d="M 109 130 A 41 41 0 0 1 191 130" stroke="#E9B342" />
    <path d="M 122 130 A 28 28 0 0 1 178 130" stroke="#6E9A4D" />
  </g>
  <path d="M 135 130 A 15 15 0 0 1 165 130 Z" fill="#3C6A93" />
  <g class="hl-base" stroke-width="4" stroke-linecap="round">
    <line x1="28" y1="136" x2="272" y2="136" />
    <line x1="138" y1="146" x2="62" y2="200" />
    <line x1="146" y1="146" x2="120" y2="200" />
    <line x1="154" y1="146" x2="180" y2="200" />
    <line x1="162" y1="146" x2="238" y2="200" />
  </g>
</svg>

<style>
  .horizon-lines { display: block; overflow: visible; }
  .horizon-lines .hl-base { stroke: #5B1A33; }
  .horizon-lines.claro .hl-base { stroke: var(--rosa-linea); }
</style>
