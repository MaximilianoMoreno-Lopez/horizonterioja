---
import { NAV, ORG } from '../lib/site.js';
import Logo from './Logo.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '');
---

<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href={`${base}/`} aria-label={`${ORG.nombre}, inicio`}>
      <Logo />
    </a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="nav-menu" aria-label="Abrir menú">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
    </button>

    <nav id="nav-menu" class="nav-menu" aria-label="Principal">
      {NAV.map((item) => (
        <a href={`${base}${item.href}`} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const menu = document.getElementById('nav-menu');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    menu?.classList.toggle('open', !open);
  });
</script>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: rgba(250, 246, 239, .92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--borde);
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; min-height: 68px; }
  .brand { font-size: 1.45rem; text-decoration: none; padding-top: 4px; }
  .nav-toggle {
    display: grid; place-items: center;
    width: 44px; height: 44px;
    background: none; border: 0; color: var(--tinta); cursor: pointer;
  }
  .nav-menu {
    display: none;
    position: absolute; left: 0; right: 0; top: 68px;
    flex-direction: column;
    background: var(--crema);
    border-bottom: 1px solid var(--borde);
    padding: 8px 16px 16px;
  }
  .nav-menu.open { display: flex; }
  .nav-menu a {
    padding: 12px 4px;
    color: var(--tinta); text-decoration: none; font-weight: 500;
    border-bottom: 1px solid var(--borde);
  }
  .nav-menu a[aria-current='page'] { color: var(--vino); }

  @media (min-width: 980px) {
    .nav-toggle { display: none; }
    .nav-menu {
      display: flex; position: static; flex-direction: row; gap: 4px;
      background: none; border: 0; padding: 0;
    }
    .nav-menu a { border: 0; padding: 8px 12px; border-radius: 999px; }
    .nav-menu a:hover { background: var(--arena); }
    .nav-menu a[aria-current='page'] { background: var(--arena); }
  }
</style>
