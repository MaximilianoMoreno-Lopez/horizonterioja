---
import { NAV, ORG } from '../lib/site.js';
import Logo from './Logo.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '');
---

<header class="nav">
  <div class="nav-velo" aria-hidden="true"></div>
  <div class="container nav-inner">
    <a class="brand" href={`${base}/`} aria-label={`${ORG.nombre}, inicio`}>
      <Logo />
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-menu" aria-label="Abrir menú">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
    </button>

    <nav id="nav-menu" class="nav-menu" aria-label="Principal">
      {NAV.map((item) => (
        <a
          href={`${base}${item.href}`}
          class:list={{ 'nav-cta': item.href === '/contacto/' }}
          aria-current={path.startsWith(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const nav = document.querySelector('.nav');
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const menu = document.getElementById('nav-menu');

  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    menu?.classList.toggle('open', open);
    nav?.classList.toggle('menu-abierto', open);
    // Con el menú abierto la página de detrás no se desplaza
    document.documentElement.style.overflow = open ? 'hidden' : '';
  };
  const isOpen = () => toggle?.getAttribute('aria-expanded') === 'true';

  toggle?.addEventListener('click', () => setOpen(!isOpen()));
  document.querySelector('.nav-velo')?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) {
      setOpen(false);
      toggle?.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (isOpen() && nav && !nav.contains(e.target as Node)) setOpen(false);
  });
  window.matchMedia('(min-width: 980px)').addEventListener('change', () => setOpen(false));

  const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: rgba(250, 246, 239, .9);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid transparent;
    transition: box-shadow .3s, background-color .3s, border-color .3s;
  }
  .nav.scrolled {
    background: rgba(250, 246, 239, .96);
    border-bottom-color: var(--borde);
    box-shadow: 0 10px 28px -20px rgba(74, 20, 40, .35);
  }
  .nav.menu-abierto { background: var(--crema); border-bottom-color: var(--borde); }
  /* Velo que oscurece la página mientras el menú móvil está abierto */
  .nav-velo {
    position: absolute;
    left: 0; right: 0; top: 100%;
    height: 100vh;
    height: 100dvh;
    background: rgba(58, 15, 32, .28);
    opacity: 0;
    visibility: hidden;
    transition: opacity .2s ease, visibility 0s linear .2s;
  }
  .nav.menu-abierto .nav-velo { opacity: 1; visibility: visible; transition-delay: 0s; }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; min-height: var(--nav-h); gap: 16px; }
  .brand { font-size: 1.5rem; text-decoration: none; padding-top: 4px; border-radius: 8px; }
  .nav-toggle {
    display: grid; place-items: center;
    width: 48px; height: 48px; margin-right: -10px;
    background: none; border: 0; color: var(--tinta); cursor: pointer;
    border-radius: 12px;
  }
  .nav-toggle line { transition: transform .25s var(--ease), opacity .2s; transform-box: fill-box; transform-origin: center; }
  .nav-toggle[aria-expanded='true'] line:nth-child(1) { transform: translateY(5px) rotate(45deg); }
  .nav-toggle[aria-expanded='true'] line:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded='true'] line:nth-child(3) { transform: translateY(-5px) rotate(-45deg); }

  /* Menú móvil */
  .nav-menu {
    display: flex;
    flex-direction: column;
    position: absolute; left: 0; right: 0; top: 100%;
    background: var(--crema);
    border-bottom: 1px solid var(--borde);
    padding: 8px 16px 24px;
    box-shadow: 0 24px 40px -24px rgba(74, 20, 40, .3);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity .2s ease, transform .25s var(--ease), visibility 0s linear .25s;
    max-height: calc(100dvh - var(--nav-h));
    overflow-y: auto;
  }
  .nav-menu.open { visibility: visible; opacity: 1; transform: none; transition-delay: 0s; }
  .nav-menu a {
    display: flex; align-items: center;
    min-height: 56px;
    padding: 0 4px;
    font-family: var(--serif);
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--tinta);
    text-decoration: none;
    border-bottom: 1px solid var(--borde);
  }
  .nav-menu a[aria-current='page'] {
    color: var(--vino);
    box-shadow: inset 3px 0 0 var(--horizonte);
    padding-left: 16px;
  }
  .nav-menu a.nav-cta {
    margin-top: 20px;
    justify-content: center;
    min-height: 52px;
    border: 0;
    border-radius: 999px;
    background: var(--vino);
    color: #fff;
    font-family: var(--sans);
    font-size: 1.05rem;
    font-weight: 600;
    box-shadow: none;
    padding: 0 20px;
  }

  @media (min-width: 980px) {
    .nav-toggle { display: none; }
    .nav-velo { display: none; }
    .nav-menu {
      position: static; flex-direction: row; align-items: center; gap: 2px;
      background: none; border: 0; padding: 0; box-shadow: none;
      visibility: visible; opacity: 1; transform: none; transition: none;
      max-height: none; overflow: visible;
    }
    .nav-menu a {
      position: relative;
      min-height: 40px;
      padding: 0 13px;
      border: 0;
      border-radius: 999px;
      font-family: var(--sans);
      font-size: .97rem;
      font-weight: 500;
      color: var(--tinta);
      transition: background-color .2s, color .2s;
    }
    .nav-menu a:hover { background: var(--vino-50); color: var(--vino-oscuro); }
    .nav-menu a[aria-current='page'] { color: var(--vino); font-weight: 600; box-shadow: none; padding-left: 13px; background: none; }
    .nav-menu a[aria-current='page']::after {
      content: '';
      position: absolute; left: 13px; right: 13px; bottom: 3px;
      height: 2px; border-radius: 2px;
      background: var(--horizonte);
    }
    .nav-menu a.nav-cta {
      margin: 0 0 0 10px;
      min-height: 42px;
      padding: 0 18px;
      background: var(--vino);
      color: #fff;
      font-size: .95rem;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.14), 0 6px 14px -8px rgba(107, 31, 58, .6);
    }
    .nav-menu a.nav-cta:hover { background: var(--vino-oscuro); color: #fff; }
    .nav-menu a.nav-cta[aria-current='page']::after { display: none; }
  }
</style>
