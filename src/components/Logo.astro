---
// Logo de Horizonte Rioja, opción "A · Amanecer entre viñas" (Logo/ en Drive):
// sol de arcos sobre el horizonte con surcos de viña, y "horizonte / RIOJA" en Bricolage Grotesque.
// Versión horizontal para cabecera y pie. Colores exactos del diseño original.
interface Props {
  claro?: boolean; // para fondos oscuros: el arco exterior, el horizonte y los surcos pasan a claro
}
const { claro = false } = Astro.props;
---

<span class:list={['logo', { claro }]}>
  <svg class="marca" viewBox="20 40 260 168" aria-hidden="true" focusable="false">
    <g fill="none" stroke-width="8" stroke-linecap="round">
      <path class="exterior" d="M 70 130 A 80 80 0 0 1 230 130" />
      <path d="M 83 130 A 67 67 0 0 1 217 130" stroke="#B83A44" />
      <path d="M 96 130 A 54 54 0 0 1 204 130" stroke="#E07A3B" />
      <path d="M 109 130 A 41 41 0 0 1 191 130" stroke="#E9B342" />
      <path d="M 122 130 A 28 28 0 0 1 178 130" stroke="#6E9A4D" />
    </g>
    <path d="M 135 130 A 15 15 0 0 1 165 130 Z" fill="#3C6A93" />
    <line class="linea" x1="28" y1="136" x2="272" y2="136" stroke-width="4" stroke-linecap="round" />
    <g class="surcos" stroke-width="5" stroke-linecap="round">
      <line x1="138" y1="146" x2="62" y2="200" />
      <line x1="146" y1="146" x2="120" y2="200" />
      <line x1="154" y1="146" x2="180" y2="200" />
      <line x1="162" y1="146" x2="238" y2="200" />
    </g>
  </svg>
  <span class="texto">
    <span class="word">horizonte</span>
    <span class="rioja">RIOJA</span>
  </span>
</span>

<style>
  .logo {
    --l-exterior: #5B1A33;
    --l-linea: #2A1A22;
    --l-word: #2A1A22;
    --l-rioja: #5B1A33;
    display: inline-flex;
    align-items: center;
    gap: .4em;
    line-height: 1;
  }
  .claro {
    --l-exterior: var(--rosa-linea);
    --l-linea: #fff;
    --l-word: #fff;
    --l-rioja: var(--horizonte);
  }
  .marca { height: 1.65em; width: auto; flex: none; overflow: visible; }
  .exterior { stroke: var(--l-exterior); }
  .linea { stroke: var(--l-linea); }
  .surcos { stroke: var(--l-exterior); }
  .texto { display: grid; justify-items: center; }
  .word {
    font-family: 'Bricolage Grotesque Variable', 'Helvetica Neue', Helvetica, sans-serif;
    font-weight: 800;
    letter-spacing: -.03em;
    color: var(--l-word);
  }
  .rioja {
    font-family: 'Bricolage Grotesque Variable', 'Helvetica Neue', Helvetica, sans-serif;
    font-weight: 600;
    font-size: .31em;
    letter-spacing: .62em;
    padding-left: .62em;
    margin-top: .3em;
    color: var(--l-rioja);
  }
</style>
