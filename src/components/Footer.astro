---
import { NAV, ORG } from '../lib/site.js';
import Logo from './Logo.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-brand"><Logo claro /></p>
      <p>Asociación juvenil sin ánimo de lucro. Juventud rural con horizonte europeo.</p>
      <p><a href={`mailto:${ORG.email}`}>{ORG.email}</a></p>
    </div>
    <nav aria-label="Pie de página">
      <p class="footer-title">La asociación</p>
      <ul>
        {NAV.map((item) => <li><a href={`${base}${item.href}`}>{item.label}</a></li>)}
      </ul>
    </nav>
    <div>
      <p class="footer-title">Legal</p>
      <ul>
        <li><a href={`${base}/aviso-legal/`}>Aviso legal</a></li>
        <li><a href={`${base}/privacidad/`}>Privacidad</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© {year} {ORG.nombreLegal} · NIF {ORG.nif} · {ORG.registro}</p>
  </div>
</footer>

<style>
  .footer { background: var(--vino-oscuro); color: #f3e6ea; padding: 56px 0 24px; margin-top: 0; }
  .footer a { color: #fff; }
  .footer ul { list-style: none; padding: 0; margin: 0; }
  .footer li { margin-bottom: .4em; }
  .footer-grid { display: grid; gap: 32px; }
  @media (min-width: 720px) { .footer-grid { grid-template-columns: 2fr 1fr 1fr; } }
  .footer-brand { font-size: 1.7rem; margin-bottom: .6em; }
  .footer-title { font-weight: 700; color: var(--horizonte); font-size: .85rem; letter-spacing: .1em; text-transform: uppercase; }
  .footer-bottom { border-top: 1px solid rgba(255,255,255,.15); margin-top: 40px; padding-top: 20px; font-size: .85rem; opacity: .85; }
  .footer-bottom p { margin: 0; }
</style>
