---
import { NAV, ORG } from '../lib/site.js';
import Logo from './Logo.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---

<div class="footer-crest" aria-hidden="true">
  <span class="crest-sol"></span>
  <svg viewBox="0 0 1440 72" preserveAspectRatio="none" focusable="false">
    <path d="M0 72 V40 C200 22 420 18 640 30 S1080 50 1440 22 V72Z" fill="#5c1a33" />
    <path d="M0 72 V52 C260 30 520 36 780 48 S1200 34 1440 44 V72Z" fill="#4a1428" />
  </svg>
</div>
<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-col-marca">
      <p class="footer-brand"><Logo claro /></p>
      <p class="footer-lema">Asociación juvenil sin ánimo de lucro. Juventud rural con horizonte europeo.</p>
      <p><a class="footer-mail" href={`mailto:${ORG.email}`}>{ORG.email}</a></p>
    </div>
    <nav aria-label="Pie de página">
      <p class="footer-title">La asociación</p>
      <ul>
        {NAV.map((item) => <li><a href={`${base}${item.href}`}>{item.label}</a></li>)}
      </ul>
    </nav>
    <div>
      <p class="footer-title">Legal</p>
      <ul>
        <li><a href={`${base}/aviso-legal/`}>Aviso legal</a></li>
        <li><a href={`${base}/privacidad/`}>Privacidad</a></li>
      </ul>
    </div>
  </div>
  <div class="container">
    <p class="footer-bottom">© {year} {ORG.nombreLegal} · NIF {ORG.nif} · {ORG.registro}</p>
  </div>
</footer>

<style>
  .footer-crest {
    position: relative;
    height: clamp(36px, 4.5vw, 64px);
    flex-shrink: 0;
    overflow: hidden;
  }
  .footer-crest svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  /* Sol que asoma por detrás de las lomas: el centro queda en la línea de la loma trasera,
     así se ve medio disco limpio. En móvil la banda es demasiado baja y se oculta. */
  .crest-sol {
    position: absolute;
    right: 16%;
    bottom: 46%;
    width: clamp(40px, 3.4vw, 54px);
    aspect-ratio: 1;
    border-radius: 50%;
    transform: translateY(50%);
    background: radial-gradient(circle at 45% 40%, #f0c46e, var(--horizonte) 70%);
    box-shadow: 0 0 0 7px rgba(224, 164, 58, .14), 0 0 26px 4px rgba(224, 164, 58, .22);
  }
  @media (max-width: 719px) { .crest-sol { display: none; } }
  .footer {
    position: relative;
    flex-shrink: 0;
    overflow: hidden;
    background: var(--vino-oscuro);
    color: #ecd9df;
    padding: clamp(32px, 5vw, 56px) 0 28px;
    margin-top: -1px;
  }
  .footer a { color: #fff; text-decoration: none; }
  .footer a:hover {
    color: #fff;
    text-decoration: underline;
    text-decoration-color: var(--horizonte);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  .footer :focus-visible { outline-color: var(--horizonte); box-shadow: 0 0 0 7px rgba(224, 164, 58, .22); }
  .footer ul { list-style: none; padding: 0; margin: 0; }
  .footer li a { display: inline-block; padding: 7px 0; }
  .footer-grid { position: relative; display: grid; gap: 36px 24px; grid-template-columns: 1fr 1fr; }
  .footer-col-marca { grid-column: 1 / -1; }
  @media (min-width: 760px) {
    .footer-grid { grid-template-columns: 2fr 1fr 1fr; }
    .footer-col-marca { grid-column: auto; }
  }
  .footer-brand { font-size: 2rem; margin-bottom: .55em; }
  .footer-lema { max-width: 38ch; }
  .footer-mail { font-weight: 600; border-bottom: 1.5px solid rgba(224, 164, 58, .7); padding-bottom: 2px; }
  .footer-mail:hover { border-bottom-color: transparent; }
  .footer-title { font-weight: 700; color: var(--horizonte); font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; margin-bottom: .6em; }
  .footer-bottom {
    position: relative;
    margin: 40px 0 0;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, .14);
    font-size: .8125rem;
    color: #e7cfd7;
  }
</style>
