---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import PageHero from '../components/PageHero.astro';
import NewsCard from '../components/NewsCard.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const noticias = (await getCollection('noticias')).sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<BaseLayout title="Actualidad" description="Noticias y crónicas de las actividades de Horizonte Rioja.">
  <PageHero eyebrow="Actualidad" title="Lo que vamos haciendo" motivo="horizonte" />

  <section class="section">
    <div class="container">
      <div class:list={['grid', noticias.length < 3 ? 'grid-2' : 'grid-3']}>
        {noticias.map((n, i) => (
          <NewsCard href={`${base}/actualidad/${n.id}/`} titulo={n.data.title} descripcion={n.data.description} fecha={n.data.date} indice={i} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
