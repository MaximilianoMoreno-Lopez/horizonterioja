---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Arrow from '../components/Arrow.astro';
import { ORG } from '../lib/site.js';

const motivos = [
  {
    titulo: 'Quiero participar',
    texto: 'En una actividad, en un intercambio o como voluntario o voluntaria.',
    asunto: 'Quiero participar',
    icon: '<path d="M8 13V5.5a1.75 1.75 0 0 1 3.5 0V12"/><path d="M11.5 11V4a1.75 1.75 0 0 1 3.5 0v7"/><path d="M15 11.5V5.5a1.75 1.75 0 0 1 3.5 0V15c0 4-2.6 6.5-6.2 6.5-2.6 0-4-1.1-5.6-3.4L4.4 14.6a1.6 1.6 0 0 1 2.6-1.9L8 14"/>',
    tono: '',
  },
  {
    titulo: 'Tengo una idea',
    texto: 'Para tu pueblo, tu centro educativo o tu grupo de amigos.',
    asunto: 'Tengo una idea',
    icon: '<path d="M9 18h6M10 21.5h4"/><path d="M12 3a6 6 0 0 0-3.6 10.8c.7.6 1.1 1.4 1.1 2.2h5c0-.8.4-1.6 1.1-2.2A6 6 0 0 0 12 3z"/>',
    tono: 'icon-oro',
  },
  {
    titulo: 'Somos una entidad',
    texto: 'Ayuntamiento, colegio, asociación u organización europea que quiere colaborar.',
    asunto: 'Colaboración entre entidades',
    icon: '<path d="M3 21h18"/><path d="M5 21V8l5-3v16"/><path d="M14 21V10l5 2.5V21"/><path d="M7.5 11v.01M7.5 14.5v.01M16.5 15v.01M16.5 18v.01"/>',
    tono: 'icon-vino',
  },
];
const [usuario, dominio] = ORG.email.split('@');
const mail = (asunto: string) => `mailto:${ORG.email}?subject=${encodeURIComponent(asunto)}`;
---

<BaseLayout title="Contacto" description="Escribe a Horizonte Rioja para participar, proponer una actividad o colaborar con nosotros.">
  <PageHero
    eyebrow="Contacto"
    title="Hablemos"
    lead="Respondemos todos los correos. Cuéntanos quién eres y qué te gustaría hacer."
    motivo="sol"
  >
    <a class="correo" href={`mailto:${ORG.email}`}>
      <span class="correo-pre">Escríbenos a</span>
      <span class="correo-dir">{usuario}<wbr />@{dominio}</span>
    </a>
    <p class="sede">Sede social en {ORG.ciudad}</p>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">¿Por qué nos escribes?</p>
        <h2>Elige un motivo y te abrimos el correo</h2>
      </div>
      <div class="grid grid-3">
        {motivos.map((m) => (
          <a class="card card-link motivo reveal" href={mail(m.asunto)}>
            <div class:list={['icon', m.tono]}>
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={m.icon} />
            </div>
            <h3>{m.titulo}</h3>
            <p>{m.texto}</p>
            <span class="leer">Escribir <Arrow /></span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .correo {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 28px;
    text-decoration: none;
    color: var(--tinta);
    max-width: 100%;
  }
  .correo-pre { font-size: .8rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--vina); }
  .correo-dir {
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-size: clamp(1.15rem, .55rem + 4.6vw, 2.3rem);
    font-weight: 500;
    letter-spacing: -.01em;
    color: var(--vino);
    text-decoration: underline;
    text-decoration-color: var(--horizonte);
    text-decoration-thickness: 3px;
    text-underline-offset: 8px;
    overflow-wrap: normal;
    transition: text-decoration-color .2s, color .2s;
  }
  .correo:hover .correo-dir { color: var(--vino-oscuro); text-decoration-color: var(--vino); }
  .motivo { border-top: 3px solid var(--vina); }
  .motivo:nth-child(2) { border-top-color: var(--horizonte); }
  .motivo:nth-child(3) { border-top-color: var(--vino); }
  .motivo p { color: var(--gris); }
  .sede { margin: 18px 0 0; font-size: .9rem; color: var(--gris); }
</style>
