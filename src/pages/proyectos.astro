---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FeatureProject from '../components/FeatureProject.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const proyectos = [
  {
    slug: 'rural-identities',
    titulo: 'Rural Identities',
    accion: 'Erasmus+ KA210⁠-⁠YOU · Asociación a pequeña escala',
    fechas: 'De diciembre de 2026 a diciembre de 2027',
    texto: 'Arte, juventud e identidad rural en La Rioja, Italia y Portugal. Dos campamentos artísticos, talleres intergeneracionales en los pueblos y una visita de estudio.',
  },
];
---

<BaseLayout title="Proyectos" description="Los proyectos europeos de Horizonte Rioja con la juventud rural.">
  <PageHero
    eyebrow="Proyectos"
    title="Lo que tenemos entre manos"
    lead="Proyectos europeos que coordinamos o en los que participamos, siempre con la juventud rural en el centro."
    motivo="vinedo"
  />

  <section class="section">
    <div class="container proyectos">
      {proyectos.map((p) => (
        <FeatureProject
          href={`${base}/proyectos/${p.slug}/`}
          chip={p.accion}
          titulo={p.titulo}
          fechas={p.fechas}
          texto={p.texto}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .proyectos { display: grid; gap: 32px; }
</style>
